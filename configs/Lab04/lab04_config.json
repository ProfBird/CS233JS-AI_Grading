{
  "rubricName": "CS233JS_Lab04_Rubric.xlsm",
  "titleCell": "A1",
  "titleText": "Lab 4: Node and Vite",
  "summaryCell": "A2",
  "runtimeCheck": "build",
  "packageCheck": {
    "dependencies": ["lit-html", "bootstrap"],
    "devDependencies": ["vite"]
  },
  "repoHygiene": {
    "excludedFromRepo": ["node_modules", "dist"]
  },
  "lint": {
    "exclude": [
      "node_modules",
      "dist"
    ]
  },
  "analysis": {
    "features": [
      {
        "id": "lit_html",
        "regex": "from\\s+['\"](?:lit-html|html-lit)['\"]",
        "fileRegex": "\\.js$"
      },
      {
        "id": "vite_sourcemap",
        "regex": "sourcemap\\s*:\\s*true",
        "fileRegex": "vite\\.config\\."
      },
      {
        "id": "module_imports",
        "regex": "import\\s+.*from",
        "fileRegex": "\\.js$"
      }
    ]
  },
  "mappings": [
