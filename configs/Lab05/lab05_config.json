{
  "rubricName": "CS233JS_Lab05_Rubric.xlsm",
  "titleCell": "A1",
  "titleText": "Lab 5: HTML Canvas",
  "summaryCell": "A2",
  "runtimeCheck": "both",
  "repoHygiene": {
    "excludedFromRepo": [
      "node_modules",
      "dist",
      ".DS_Store"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules",
      "dist"
    ]
  },
  "analysis": {
    "features": [
      {
        "id": "canvas_context",
        "regex": "getContext\\(['\"]2d['\"]\\)",
        "fileRegex": "\\.js$"
      },
      {
        "id": "local_storage",
        "regex": "localStorage",
        "fileRegex": "\\.js$"
      },
      {
        "id": "lena_js",
        "regex": "from\\s+['\"]lena",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_filter",
        "regex": "\\.filter\\s*=",
        "fileRegex": "\\.js$"
      },
      {
        "id": "module_imports",
        "regex": "import\\s+.*from",
        "fileRegex": "\\.js$"
      },
      {
        "id": "filter_names",
        "regex": "\\b(?:grayscale|sepia|contrast|brightness|blur|saturate|hue-rotate|invert|opacity)\\b",
        "fileRegex": "\\.js$"
      },
      {
        "id": "stroke_text",
        "regex": "\\bstrokeText\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_clip_shape",
        "regex": "\\b(?:arc|ellipse|roundRect)\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_advanced_feature",
        "regex": "\\b(?:scale|lineTo|drawImage)\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "canvas_styling",
        "regex": "(?:\\.fillStyle|\\.strokeStyle|\\.font)\\s*=",
        "fileRegex": "\\.js$"
      }
    ]
  },
  "mappings": [
    {
      "cell": "C7",
      "commentCell": "E7",
      "type": "feature",
      "featureId": "local_storage",
      "minCount": 1,
      "maxScore": 5,
      "successMsg": "Yes - localStorage usage found",
      "failMsg": "No localStorage usage found"
    },
    {
      "cell": "C8",
      "commentCell": "E8",
      "type": "feature",
      "featureId": "filter_names",
      "minCount": 4,
      "maxScore": 3,
      "successMsg": "Yes - 4+ filter keywords found",
      "failMsg": "Fewer than 4 filter keywords found"
    },
    {
      "cell": "C9",
