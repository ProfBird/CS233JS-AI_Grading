    "exclude": [
      "node_modules",
      "dist"
    ]
  },
  "analysis": {
    "features": [
      {
        "id": "fetch_api",
        "regex": "fetch\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "async_await",
        "regex": "\\basync\\b",
        "fileRegex": "\\.js$"
      },
      {
        "id": "json_parse",
        "regex": "\\.json\\(",
        "fileRegex": "\\.js$"
      },
      {
        "id": "local_storage",
        "regex": "localStorage",
        "fileRegex": "\\.js$"
      },
      {
        "id": "module_imports",
        "regex": "import\\s+.*from",
        "fileRegex": "\\.js$"
      }
    ],
    "customAnalyzer": "lab06_analyzer.js"
  },
  "mappings": [
