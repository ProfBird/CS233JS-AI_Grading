{
  "rubricName": "CS233JS_Lab06_Rubric.xlsm",
  "titleCell": "A1",
  "titleText": "Lab 6: Async JS and Web APIs",
  "summaryCell": "A2",
  "graderCell": "E1",
  "codeReview": { "studentNameCell": "B1", "groupCell": "C1" },
  "runtimeCheck": "both",
  "repoHygiene": {
    "excludedFromRepo": [
      "node_modules",
      "dist",
      ".DS_Store"
    ]
  },
