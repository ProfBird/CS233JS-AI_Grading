#!/bin/sh
#
# Pre-commit hook: run the test suite before allowing a commit.
#
# Activated via `core.hooksPath` (see the "prepare" script in package.json,
# which runs automatically on `npm install`). To bypass in an emergency:
#   git commit --no-verify
#
echo "Running tests before commit..."
npm test --silent
if [ $? -ne 0 ]; then
	echo ""
	echo "✗ Tests failed — commit aborted."
	echo "  Fix the tests, or bypass with: git commit --no-verify"
	exit 1
fi
echo "✓ Tests passed."
exit 0
